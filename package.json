{
  "name": "simple-mail-cleaner",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open-source dashboard for AI-assisted email cleanup with explicit user approvals.",
  "repository": { "type": "git", "url": "git+https://github.com/xFlayZ/SimpleMailCleaner.git" },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "connector": "tsx --env-file=.env.connector scripts/connector.ts",
    "setup": "node scripts/setup.mjs",
    "test:integration": "tsx --env-file=.env scripts/integration.ts",
    "test:api": "tsx --env-file=.env scripts/api-smoke.ts",
    "test:scans": "tsx --env-file=.env scripts/scan-integration.ts",
    "test:scan-api": "tsx --env-file=.env scripts/scan-api-smoke.ts"
  },
  "dependencies": {
    "imapflow": "^1.0.195",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mailauth": "^8.0.4",
    "mailparser": "^3.7.4",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
