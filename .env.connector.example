SERVER_URL=http://localhost:3000
CONNECTOR_TOKEN=
# Device-specific key supplied once by the pairing UI.
CONNECTOR_DEVICE_KEY=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=1143
BRIDGE_SECURE=false
